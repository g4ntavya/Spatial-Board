# Copy to .env.local for local dev, and set the same in your Vercel project.
# All values come from the CDK stack outputs (cdk deploy prints them).
AWS_REGION=us-east-1
AURORA_CLUSTER_ARN=arn:aws:rds:us-east-1:251335055096:cluster:REPLACE
AURORA_SECRET_ARN=arn:aws:secretsmanager:us-east-1:251335055096:secret:spatialboard/db-REPLACE
DB_NAME=spatialboard
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# IAM user credentials with rds-data + bedrock:InvokeModel + secret read.
AWS_ACCESS_KEY_ID=REPLACE
AWS_SECRET_ACCESS_KEY=REPLACE
