# Copy to .env.local for local dev, and set the SAME variables in your Vercel
# project (Settings → Environment Variables), then redeploy. Most values come
# from the CDK stack outputs (cdk deploy prints them).

# REQUIRED — NextAuth session signing. Without this, every auth route 500s and
# login silently fails (you stay on the sign-in screen). Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=REPLACE

AWS_REGION=us-east-1
AURORA_CLUSTER_ARN=arn:aws:rds:us-east-1:251335055096:cluster:REPLACE
AURORA_SECRET_ARN=arn:aws:secretsmanager:us-east-1:251335055096:secret:spatialboard/db-REPLACE
DB_NAME=spatialboard
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
# SQS queue the "Convert to text" button posts to (CDK output QueueUrl).
NOTES_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/REPLACE

# IAM user creds with: rds-data:ExecuteStatement, secretsmanager:GetSecretValue,
# bedrock:InvokeModel, sqs:SendMessage. (Locally these come from ~/.aws instead.)
AWS_ACCESS_KEY_ID=REPLACE
AWS_SECRET_ACCESS_KEY=REPLACE
